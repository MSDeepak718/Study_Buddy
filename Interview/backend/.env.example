CHROMA_COLLECTION_NAME=interview_documents
EMBEDDING_MODEL=all-MiniLM-L6-v2
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
